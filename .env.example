# Copie para .env.local e preencha. .env.local não vai pro git.
# As mesmas variáveis precisam existir na Vercel (Project > Settings > Env).
#
# ATENÇÃO ao prefixo: tudo que começa com VITE_ é embutido no JavaScript
# público da página e QUALQUER PESSOA consegue ler. O que não tem o prefixo
# só existe no servidor (funções em api/) e nunca chega ao navegador.

# ---------------------------------------------------------------------------
# Público (vai para o navegador)
# ---------------------------------------------------------------------------

# ID do pixel / dataset da Meta. Gerenciador de Eventos > Fontes de dados.
# Não é segredo: ele aparece no código do pixel de qualquer site.
VITE_META_PIXEL_ID=

# Só para apontar o formulário para outro lugar em teste. Vazio = /api/lead.
VITE_LEAD_ENDPOINT=

# ---------------------------------------------------------------------------
# Servidor (nunca chega ao navegador)
# ---------------------------------------------------------------------------

# Chave de API do CRM DataCrazy. É SEGREDO: dá acesso total à base de leads.
# Gerada em crm.datacrazy.io/config/api — aparece UMA VEZ SÓ na tela.
DATACRAZY_TOKEN=

# Etapa do funil onde o negócio do lead nasce. Sem ela o lead é criado, mas
# fica fora do pipeline (ninguém vê no quadro). Descobrir com:
#   GET https://api.g1.datacrazy.io/api/v1/pipelines
#   GET https://api.g1.datacrazy.io/api/v1/pipelines/{id}/stages
# Hoje: funil "Aquisição de Clientes" > etapa "Entrada de Lead".
DATACRAZY_STAGE_ID=

# Tags aplicadas no lead, IDs separados por vírgula. Opcional.
DATACRAZY_TAG_IDS=

# Base da API. Vazio = https://api.g1.datacrazy.io
DATACRAZY_API_URL=

# Token da Conversions API. Gerenciador de Eventos > seu dataset >
# Configurações > Conversions API > Gerar token de acesso.
# É SEGREDO: dá para enviar eventos em nome do dataset.
META_CAPI_ACCESS_TOKEN=

# ID do pixel para o lado servidor. Mesmo valor de VITE_META_PIXEL_ID.
META_PIXEL_ID=

# Versão da Graph API. Vazio = v25.0 (suportada até jul/2028).
META_GRAPH_VERSION=

# Preencha SÓ enquanto testa. Com isto setado os eventos aparecem em
# "Testar eventos" e NÃO contam como conversão. Apague antes de anunciar.
META_TEST_EVENT_CODE=

# Senha compartilhada com o n8n para chamar /api/crm-event (header
# x-b2o-secret). Gere algo longo e aleatório.
CRM_EVENT_SECRET=
